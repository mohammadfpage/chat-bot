# Secrets — never inside the image; the Worker forwards env vars instead.
# NOTE: this file only applies to the LEGACY in-place build (context = this
# directory). With `image_build_context: "../.."` the context is the repo
# root, so Docker reads the ROOT `.dockerignore` instead.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.bak

# Local state: databases, WAL siblings, backups, logs
*.db
*.db-wal
*.db-shm
backups/
logs/

# Tooling / build-context noise
.git/
.github/
.opencode/
.vscode/
.idea/
venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
node_modules/
.wrangler/
