[Unit]
Description=Anonymous Chat Bot (aiogram 3, long polling, SQLite)
After=network-online.target
Wants=network-online.target
# A config/token error makes the bot exit within seconds; without a limit
# systemd would restart it in a tight loop and bury the real error in journald.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# Run as a dedicated non-root user (create with: sudo useradd -r -s /usr/sbin/nologin pixelbot)
User=pixelbot
Group=pixelbot
WorkingDirectory=/opt/pixel-bot
EnvironmentFile=/opt/pixel-bot/.env
ExecStart=/opt/pixel-bot/venv/bin/python /opt/pixel-bot/bot.py
Restart=always
RestartSec=5
# Graceful shutdown (bot.py closes the session, disposes the engine, flushes WAL)
KillSignal=SIGINT
TimeoutStopSec=30
# Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
