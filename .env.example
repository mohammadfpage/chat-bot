# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_token_here

# Root Admin IDs (comma-separated Telegram user IDs)
ADMIN_IDS=7174138646,123456789

# Force-Join Channel Settings
CHANNEL_ID=-1001234567890
CHANNEL_USERNAME=@YourChannel

# ─────────────────────────────────────────────────────────────
# Inline Mode (Anonymous Messaging)
# Thumbnail icon of the inline result. The Bot API only accepts a public
# HTTPS image URL here — a Telegram file_id is NOT valid. Leave empty to
# publish the result without a thumbnail.
# Reminder: inline mode must be switched ON in @BotFather via /setinline.
# ─────────────────────────────────────────────────────────────
INLINE_THUMBNAIL_URL=https://example.com/anon-icon.png

# ─────────────────────────────────────────────────────────────
# Inline menu icons (the 3 options shown for a bare "@bot")
# هر کدام از سه گزینهٔ منوی اینلاین آیکون خودش را دارد تا ردیف‌های
# لیست پیش از خواندن متن از هم تشخیص داده شوند. شرایط همان بالاست:
# آدرس عمومی https، حداکثر ۱ کیلوبایت، حداکثر ۲۰۰×۲۰۰ پیکسل.
# اگر خالی بمانند، به INLINE_THUMBNAIL_URL برمی‌گردند و اگر آن هم خالی
# باشد، آن گزینه بدون آیکون نمایش داده می‌شود (که هم مشکلی ندارد).
#   INLINE_TUTORIAL_THUMB  → آموزش ارسال نجوا (آیکون سبز سؤال)
#   INLINE_WHISPER_THUMB   → درخواست نجوا (آیکون بنفش آیدی)
#   INLINE_ANON_CHAT_THUMB → درخواست پیام ناشناس (آیکون صورتی پیام)
# ─────────────────────────────────────────────────────────────
INLINE_TUTORIAL_THUMB=
INLINE_WHISPER_THUMB=
INLINE_ANON_CHAT_THUMB=

# ─────────────────────────────────────────────────────────────
# Tutorial media
# عکسی که دکمهٔ «💡 عکس آموزشی» در کارت آموزش نشان می‌دهد. اگر خالی
# بماند، همان دکمه به یک کال‌بک تبدیل می‌شود که آموزش را به شکل
# نوشتاری/مرحله‌به‌مرحله داخل گفتگو باز می‌کند.
# ─────────────────────────────────────────────────────────────
TUTORIAL_PHOTO_URL=

# ─────────────────────────────────────────────────────────────
# Group Keyboard Cleanup (on startup)
# تلگرام کیبوردِ پایین چت را «به‌ازای هر گفتگو» کش می‌کند و با حذف یا
# دوباره اضافه کردن ربات پاک نمی‌شود. در هر استارت، این تنظیم باعث
# می‌شود ربات ReplyKeyboardRemove را دوباره برای همهٔ گروه‌های ثبت‌شده
# بفرستد تا کیبوردِ گیرکرده برای همهٔ اعضا پاک شود.
#   GROUP_KEYBOARD_CLEANUP=false  → غیرفعال کردن کامل این پاکسازی
#   GROUP_KEYBOARD_CLEANUP_DELAY   → چند ثانیه صبر قبل از حذف پیامِ نامرئی
#     (کلاینت‌ها هنگام دریافت پیام، کیبورد را پاک می‌کنند؛ اگر زود حذف
#      شود، بعضی کلاینت‌ها فرصت پردازش ندارند)
# ─────────────────────────────────────────────────────────────
GROUP_KEYBOARD_CLEANUP=true
GROUP_KEYBOARD_CLEANUP_DELAY=2.0

# Database URL (SQLite for local dev, swap to PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///database.db

# ─────────────────────────────────────────────────────────────
# FSM storage (اختیاری — فقط برای Cloudflare / ری‌استارت‌ها)
# حالت‌های نیمه‌کاره ( wizards، صف جستجو ) به‌صورت پیش‌فرض در حافظهٔ
# فرایند هستند و با هر ری‌استارت پاک می‌شوند. روی سرور محلی همین
# پیش‌فرض درست است؛ روی Cloudflare Containers که فرایند را می‌خواباند
# یک Redis بدهید تا وضعیت کاربر از بین نرود:
#   REDIS_URL=redis://default:<password>@<host>:6379/0
# خالی بماند = MemoryStorage؛ آدرس خراب = هشدار در لاگ + بازگشت به
# MemoryStorage (هرگز مانع بالا آمدن ربات نمی‌شود).
# ─────────────────────────────────────────────────────────────
REDIS_URL=

# ─────────────────────────────────────────────────────────────
# Economy / Policy (مدیریت زنده از پنل ادمین → "محدودیت و سیاست")
# مقادیر پیش‌فرض در جدول خودکار bot_policy ساخته می‌شوند و
# ادمین می‌تواند از پنل آن‌ها را تغییر دهد:
#   - محدودیت پیام در دقیقه / ساعت (ضد اسپم)
#   - سهمیه روزانه توکن (پیش‌فرض ۳۰) و هزینهٔ هر پیام (۱)
#   - سکه خوش‌آمدگویی، سکه جایزه روزانه (۲۵) و نرخ تبدیل سکه
#   - پاداش رفرال: سکه + روز اشتراک برای دعوت‌کننده
#   - توکن خوش‌آمد دعوت‌شده (۱۵) — هر دو طرف سود می‌برند
#
# اصل منصفانه: شارژ روزانه توکن همیشه TOP-UP است یعنی
# توکن‌های هدیه/رفرال هیچ‌وقت با ریست روزانه حذف نمی‌شوند.
# ─────────────────────────────────────────────────────────────


# ─────────────────────────────────────────────────────────────
# Run mode / حالت اجرا
#   RUN_MODE=polling  → دریافت آپدیت با long polling (پیش‌فرض؛ بدون نیاز به
#                       هیچ تنظیم شبکه، دامنه یا SSL — برای تست لوکال)
#   RUN_MODE=webhook  → راه‌اندازی سرور HTTP محلی + ثبت آدرس در تلگرام با
#                       setWebhook. برای تست لوکال «بدون نیاز به SSL» این
#                       مراحل را دنبال کن (راهنما: WEBHOOK.md):
#                         1) cloudflared tunnel --url http://127.0.0.1:8080
#                         2) آدرس https://... چاپ‌شده را در WEBHOOK_BASE_URL
#                            بگذارید و ربات را استارت کنید
#                       تلگرام فقط https:// می‌پذیرد؛ خود سرور محلی HTTP
#                       است و TLS را تونل یا ریورس‌پراکسی می‌سازد.
# ─────────────────────────────────────────────────────────────
RUN_MODE=polling

# آدرس عمومی https پایه (بدون اسلش انتهایی) — فقط در حالت webhook
#   لوکال : https://xxxx-yyyy.trycloudflare.com   (از cloudflared)
#   سرور  : https://bot.example.com
WEBHOOK_BASE_URL=

# مسیر webhook روی سرور محلی (اسلش ابتدایی خودکار اضافه می‌شود)
WEBHOOK_PATH=/telegram/webhook

# توکن امنیتی وبهوک — در همهٔ درخواست‌های تلگرام به صورت هدر
# X-Telegram-Bot-Api-Secret-Token ارسال و قبل از هر هندلری بررسی می‌شود.
# فقط A-Z a-z 0-9 _ - (حداکثر ۲۵۶ کاراکتر). خالی بگذارید تا در هر بار
# اجرا یکی تصادفی ساخته و با setWebhook ثبت شود.
WEBHOOK_SECRET=

# آدرس/پورت bind سرور محلی. 127.0.0.1 برای تونل یا ریورس‌پراکسی همان
# دستگاه کافی است؛ 0.0.0.0 فقط وقتی لازم است که چیز دیگری از شبکه به
# پورت دسترسی بخواهد. تلگرام مستقیماً فقط پورت‌های 443/80/88/8443 را
# قبول دارد (تونل/پراکسی پورت محلی را پنهان می‌کند).
# روی هاست (مثل Render) این دو را دست نزنید: آن‌ها به‌طور خودکار PORT را
# می‌دهند؛ ربات همان پورت را می‌خواند و اگر WEBAPP_HOST را صریحاً
# تعیین نکرده باشید روی 0.0.0.0 گوش می‌دهد. لوکال 127.0.0.1 امن‌تر است.
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080

# PORT — توسط پلتفرم‌های میزبانی (Render/Railway/Fly/...) به‌صورت خودکار
# ست می‌شود و بر WEBAPP_PORT اولویت دارد. لوکال خالی بگذارید.
PORT=

# Proxy for regions where api.telegram.org is filtered.
# Leave empty for a direct connection. Run `python test_connection.py`
# first to find out which route works on this machine.
#   PROXY_URL=socks5://127.0.0.1:1080
#   PROXY_URL=socks5://user:pass@host:1080
#   PROXY_URL=http://127.0.0.1:8080
PROXY_URL=
